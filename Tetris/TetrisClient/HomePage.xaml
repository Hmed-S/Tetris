<Page x:Class="TetrisClient.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TetrisClient"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="HomePage">
    <Grid x:Name="main_grid" Margin="0,24,0,96"
          xmlns:local="clr-namespace:TetrisClient.Controls"
          >

        <Label x:Name="Title" Content="Ahmed-S' Multiplayer Tetris" HorizontalAlignment="Center" Margin="0,26,0,0" VerticalAlignment="Top" Foreground="White" Width="453" FontSize="36" Height="56"/>

        <local:TetrisMenuButton
            Content="Singleplayer"
            HorizontalAlignment="Center"
            Margin="0,101,0,0" VerticalAlignment="Top"
            Click="Start_Single_player_Game"
           />

        <local:TetrisMenuButton
            Content="Multiplayer"
            HorizontalAlignment="Center"
            Margin="0,157,0,0" VerticalAlignment="Top"
            Click="Start_MultiPlayer_Game"
           />


        
    </Grid>
</Page>
