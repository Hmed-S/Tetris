<UserControl x:Class="TetrisClient.Controls.ControlPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TetrisClient.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Background="#FF001428">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Label x:Name="Title"
               Content="How to play:"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               Foreground="White"
               FontSize="36" Margin="303,-6,0,0"/>

        <UniformGrid Columns="2" Rows="3" Grid.Row="1" Margin="24,0">
            <StackPanel Orientation="Horizontal" Margin="8" VerticalAlignment="Center">
                <TextBlock Text="Pause:" Foreground="White" VerticalAlignment="Center" FontSize="16" Margin="0,0,10,0"/>
                <Grid Width="48" Height="38" Margin="2,0">
                    <Path Stretch="Fill" Stroke="White" StrokeThickness="2" Fill="Transparent"
                          Data="M 6,2 H 42 Q 46,2 46,6 V 32 Q 46,36 42,36 H 6 Q 2,36 2,32 V 6 Q 2,2 6,2 Z"/>
                    <TextBlock Text="Esc" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                </Grid>
                <Grid Width="48" Height="38" Margin="2,0">
                    <Path Stretch="Fill" Stroke="White" StrokeThickness="2" Fill="Transparent"
                          Data="M 6,2 H 42 Q 46,2 46,6 V 32 Q 46,36 42,36 H 6 Q 2,36 2,32 V 6 Q 2,2 6,2 Z"/>
                    <TextBlock Text="F1" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                </Grid>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="8" VerticalAlignment="Center">
                <TextBlock Text="Move left:" Foreground="White" VerticalAlignment="Center" FontSize="16" Margin="0,0,10,0"/>
                <Grid Width="48" Height="38">
                    <Path Stretch="Fill" Stroke="White" StrokeThickness="2" Fill="Transparent"
                          Data="M 6,2 H 42 Q 46,2 46,6 V 32 Q 46,36 42,36 H 6 Q 2,36 2,32 V 6 Q 2,2 6,2 Z"/>
                    <TextBlock Text="←" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22"/>
                </Grid>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="8" VerticalAlignment="Center">
                <TextBlock Text="Move right:" Foreground="White" VerticalAlignment="Center" FontSize="16" Margin="0,0,10,0"/>
                <Grid Width="48" Height="38">
                    <Path Stretch="Fill" Stroke="White" StrokeThickness="2" Fill="Transparent"
                          Data="M 6,2 H 42 Q 46,2 46,6 V 32 Q 46,36 42,36 H 6 Q 2,36 2,32 V 6 Q 2,2 6,2 Z"/>
                    <TextBlock Text="→" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22"/>
                </Grid>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="8" VerticalAlignment="Center">
                <TextBlock Text="Rotate right:" Foreground="White" VerticalAlignment="Center" FontSize="16" Margin="0,0,10,0"/>
                <Grid Width="48" Height="38" Margin="2,0">
                    <Path Stretch="Fill" Stroke="White" StrokeThickness="2" Fill="Transparent"
                          Data="M 6,2 H 42 Q 46,2 46,6 V 32 Q 46,36 42,36 H 6 Q 2,36 2,32 V 6 Q 2,2 6,2 Z"/>
                    <TextBlock Text="↑" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22"/>
                </Grid>
                <Grid Width="48" Height="38" Margin="2,0">
                    <Path Stretch="Fill" Stroke="White" StrokeThickness="2" Fill="Transparent"
                          Data="M 6,2 H 42 Q 46,2 46,6 V 32 Q 46,36 42,36 H 6 Q 2,36 2,32 V 6 Q 2,2 6,2 Z"/>
                    <TextBlock Text="X" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                </Grid>
            </StackPanel>

            <Grid Margin="8,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Rotate left:" Foreground="White" VerticalAlignment="Center" FontSize="16" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="48" Height="34" Margin="2,0">
                            <Path Stretch="Fill" Stroke="White" StrokeThickness="2" Fill="Transparent"
                                  Data="M 6,2 H 42 Q 46,2 46,6 V 32 Q 46,36 42,36 H 6 Q 2,36 2,32 V 6 Q 2,2 6,2 Z"/>
                            <TextBlock Text="↓" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22"/>
                        </Grid>
                        <Grid Width="48" Height="34" Margin="2,0">
                            <Path Stretch="Fill" Stroke="White" StrokeThickness="2" Fill="Transparent"
                                  Data="M 6,2 H 42 Q 46,2 46,6 V 32 Q 46,36 42,36 H 6 Q 2,36 2,32 V 6 Q 2,2 6,2 Z"/>
                            <TextBlock Text="Z" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                        </Grid>
                        <Grid Width="48" Height="34" Margin="2,0">
                            <Path Stretch="Fill" Stroke="White" StrokeThickness="2" Fill="Transparent"
                                  Data="M 6,2 H 42 Q 46,2 46,6 V 32 Q 46,36 42,36 H 6 Q 2,36 2,32 V 6 Q 2,2 6,2 Z"/>
                            <TextBlock Text="Ctrl" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/>
                        </Grid>
                    </StackPanel>
                    <Grid Width="78" Height="38" Margin="39,2,0,0" HorizontalAlignment="Left">
                        <Path Stretch="Fill" Stroke="White" StrokeThickness="2" Fill="Transparent"
                              Data="M 6,2 H 72 Q 76,2 76,6 V 32 Q 76,36 72,36 H 6 Q 2,36 2,32 V 6 Q 2,2 6,2 Z"/>
                        <TextBlock Text="Right Shift" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="8" VerticalAlignment="Center">
                <TextBlock Text="Fast drop:" Foreground="White" VerticalAlignment="Center" FontSize="16" Margin="0,0,10,0"/>
                <Grid Width="92" Height="38">
                    <Path Stretch="Fill" Stroke="White" StrokeThickness="2" Fill="Transparent"
                          Data="M 6,2 H 86 Q 90,2 90,6 V 32 Q 90,36 86,36 H 6 Q 2,36 2,32 V 6 Q 2,2 6,2 Z"/>
                    <TextBlock Text="Space" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                </Grid>
            </StackPanel>
        </UniformGrid>
    </Grid>

</UserControl>
